# ============================================================================
# .env de PRODUCCION - https://api-not.devrob.net
#
# - Se crea A MANO en el servidor, en la RAIZ DEL PROYECTO: /home/devrobne/api-not.devrob.net/.env,
#   al mismo nivel que public/, src/ y vendor/. NUNCA dentro de public/.
# - NUNCA se commitea ni lo sube el pipeline (esta excluido: **/.env y **/.env.*).
# - Permisos recomendados: 600.
# - Si un valor contiene espacios, # o $, encierralo entre comillas simples: DB_PASSWORD='ab#cd$ef'
# - Guia completa: documentation/releases/02_server_configuration.md
# ============================================================================

# --- Application -------------------------------------------------------------
# El codigo NO lee APP_NAME, APP_ENV ni APP_URL (solo APP_DEBUG y APP_TIMEZONE),
# se mantienen por consistencia con .env.example.
APP_NAME=NotarialAPI
APP_ENV=production
# OBLIGATORIO false: con true, los errores 500 devuelven el mensaje de la excepcion
APP_DEBUG=false
APP_URL=https://api-not.devrob.net

# --- Database (cPanel) -------------------------------------------------------
# cPanel antepone el usuario de la cuenta: devrobne_<nombre>
# El host es localhost (la BD esta en el mismo servidor). DB_ROOT_PASSWORD NO se usa
# en produccion (solo lo usa docker-compose en local).
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=devrobne_notarial
DB_USERNAME=devrobne_notarial
DB_PASSWORD=CAMBIAR_POR_PASSWORD_GENERADO

# --- JWT ---------------------------------------------------------------------
# Generar con:  openssl rand -base64 48
# Debe ser DISTINTO al de desarrollo. Si se cambia despues, todas las sesiones activas
# quedan invalidas (los usuarios tendran que volver a iniciar sesion).
JWT_SECRET=CAMBIAR_POR_SECRETO_GENERADO_MIN_32_CARACTERES
JWT_EXPIRATION=7200
JWT_REFRESH_EXPIRATION=86400
JWT_ISSUER=security@devrob
JWT_AUDIENCE=apps@devrob

# --- Timezone ----------------------------------------------------------------
APP_TIMEZONE=America/Mexico_City
